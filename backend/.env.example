# ---------------------------------------------------------
# Gym Slot Booking - Backend Environment Configuration
# Copy this file to `.env` and fill in real values for local dev.
# NEVER commit a real .env file.
# ---------------------------------------------------------

# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (authoritative transactional store)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=gym_slot_booking
PG_USER=gymapp
PG_PASSWORD=gymapp_dev_password
PG_POOL_MAX=10
# Alternative: a single connection string can be used instead of the fields above
# PG_CONNECTION_STRING=postgresql://gymapp:gymapp_dev_password@localhost:5432/gym_slot_booking

# MongoDB (audit / activity log)
MONGO_URI=mongodb://localhost:27017/gym_slot_booking_logs

# Redis (cache + rate limiting)
REDIS_URL=redis://localhost:6379
SLOTS_CACHE_TTL_SECONDS=15

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=1d

# Rate limiting (POST /api/bookings)
BOOKING_RATE_LIMIT_WINDOW_MS=60000
BOOKING_RATE_LIMIT_MAX=10

# Test database (used by integration/concurrency tests, must be a DIFFERENT db)
TEST_PG_DATABASE=gym_slot_booking_test
